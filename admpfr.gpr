library project Admpfr is

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src");

   type Target_type is ("Windows_NT", "UNIX");
   Target : Target_type := external ("OS", "UNIX");

   type Build_Type is ("Debug", "Release");
   Build : Build_Type := external ("PRJ_BUILD", "Debug");

   type Library_Type_Kind is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Kind :=
     external ("ADMPFR_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));


   for Library_Name use "admpfr";
   for Library_Kind use Library_Type;

   for Library_Dir use "lib/" & Library_Type;
   for Object_Dir use "obj/" & Library_Type;

   Mpfr_Libs := ("-lmpfr");
   case Target is
      when "Windows_NT" => Mpfr_Libs := ("-lmpfr", "-lgmp");
      when "UNIX"       => null;
   end case;

   --  Archives (static, static-pic) only accept object files here.
   case Library_Type is
      when "relocatable" => for Library_Options use Mpfr_Libs;
      when others        => null;
   end case;

   package Compiler is

      GNAT_Options := ("-gnata", "-gnatVa", "-gnatQ", "-gnatyg", "-gnateE",
         "-gnatwaCJe", "-fstack-check", "-gnatwae", "-gnat2022");

      case Build is
         when "Debug" =>
            for Switches ("Ada") use ("-g", "-O0") & GNAT_Options;
            for Switches ("C") use ("-g", "-Wall" ,"-Werror");
         when "Release" =>
            for Switches ("Ada") use ("-O2") & GNAT_Options;
            for Switches ("C") use ("-O2");
      end case;

   end Compiler;

   package Linker is
      for Linker_Options use Mpfr_Libs;
   end Linker;

end Admpfr;
